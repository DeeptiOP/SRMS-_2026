# Railway Database Configuration (Production)
# Get these values from your Railway MySQL database
DB_HOST=containers-us-west-xxx.railway.app
DB_USER=root
DB_PASSWORD=your_railway_db_password
DB_NAME=railway

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-super-secret-key-here-change-this-in-production
WTF_CSRF_SECRET_KEY=csrf-secret-key-change-this-in-production

# Admin Configuration
ADMIN_REGISTRATION_KEY=SECURE_ADMIN_KEY_CHANGE_THIS

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# Server
HOST=0.0.0.0
PORT=10000
